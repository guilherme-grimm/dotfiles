[
  // ============================================================
  // HP 524pf 24" — vertical (1080px wide after rotation)
  // Pinned by monitor description, not port name, so swapping
  // docks/cables no longer puts this bar on the wrong screen.
  // Minimal set, icon-heavy
  // ============================================================
  {
  "name": "vertical",
  "output": "HP Inc. HP 524pf VNG5420L4G",
  "layer": "top",
  "position": "top",
  "height": 16,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "custom/vpn",
    "tray",
    "custom/power"
  ],

  "include": "~/.config/waybar/modules.jsonc"
  },

  // ============================================================
  // Gigabyte GS27QA 27" 2K — center (your primary, full setup)
  // Pinned by monitor description (survives port reassignments).
  // ============================================================
  {
    "name": "main",
    "output": "GIGA-BYTE TECHNOLOGY CO., LTD. GS27QA 0x000008D4",
    "layer": "top",
    "position": "top",
    "height": 16,

    "modules-left": [
      "custom/launcher",
      "hyprland/workspaces",
      "custom/updates",
      "custom/cava"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "memory",
      "cpu",
      "temperature",
      "idle_inhibitor",
      "hyprland/language",
      "keyboard-state",
      "custom/sunset",
      "pulseaudio",
      "network",
      "custom/vpn",
      "custom/notification",
      "tray",
      "custom/power"
    ],

    "include": "~/.config/waybar/modules.jsonc"
  },

  // ============================================================
  // eDP-1 — Laptop (1920px, trimmed to avoid clamping)
  // ============================================================
  {
    "name": "laptop",
    "output": "eDP-1",
    "layer": "top",
    "position": "top",
    "height": 16,

    "modules-left": [
      "custom/launcher",
      "hyprland/workspaces",
      "custom/updates"
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "memory",
      "cpu",
      "temperature",
      "battery",
      "backlight",
      "pulseaudio",
      "network",
      "tray",
      "custom/power"
    ],

    "include": "~/.config/waybar/modules.jsonc"
  }
]
